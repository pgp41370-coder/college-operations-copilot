# College Operations Copilot — environment variables.
# Copy to .env.local for local development. Never commit real values.

# Required. Postgres connection string. Use a pooled URL on serverless hosts
# (e.g. Neon "-pooler" host or Supabase transaction pooler).
DATABASE_URL=postgres://localhost:5432/college_ops_dev

# Optional: LLM-assisted extraction via any OpenAI-compatible endpoint.
# Leave unset to run fully deterministic (default). Nothing is paid by default.
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_API_KEY=

# Tests only (defaults shown).
# TEST_DATABASE_URL=postgres://localhost:5432/college_ops_test
# TEST_DATABASE_ADMIN_URL=postgres://localhost:5432/postgres
